# Copy this to .env and fill in for your setup.
# Only the variables for your chosen LLM_BACKEND need to be set (and only
# when DEMO_MODE=false).

# ---- Demo mode ----
# true  = HTTP surface + call loop run with canned data; no models or keys.
# false = real STT (faster-whisper), LLM, and TTS (Piper).
DEMO_MODE=true

# ---- LLM backend selection: ollama | llamacpp | api ----
LLM_BACKEND=ollama

# -- ollama --
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# -- llamacpp (run `llama-server -m model.gguf --port 8080` separately) --
LLAMACPP_HOST=http://127.0.0.1:8080

# -- api (hosted) --
API_PROVIDER=anthropic        # anthropic | openai
API_BASE_URL=https://api.anthropic.com/v1/messages
API_MODEL=claude-sonnet-4-6
API_KEY=<set-value>

# ---- Speech ----
WHISPER_MODEL=small.en        # base.en / small.en / medium.en
WHISPER_DEVICE=cpu            # cuda or cpu
PIPER_VOICE=/piper-voices/en_US-amy-medium.onnx

# ---- Bot ports ----
BOT_WS_PORT=8765              # call audio WebSocket
BOT_HTTP_PORT=8766            # HTTP overview page + /healthz
